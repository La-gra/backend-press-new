# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/press_db
DIRECT_URL=postgresql://user:password@localhost:5432/press_db

# Server Configuration
PORT=5000
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:5000                    # Full backend URL for media absolute URLs
FRONTEND_URL=http://localhost:3000                   # Full frontend URL for article links

# JWT
JWT_ACCESS_SECRET=your-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here

# Multer (File Upload)
MULTER_DEST=./uploads
MULTER_MAX_SIZE=10485760                             # 10MB in bytes
